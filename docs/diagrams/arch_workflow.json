      "title": "Bounded 4-Step Contract (agent/controller.py)",
      "items": [
        "Step 1 SEARCH: Hybrid dense (FAISS) and sparse (BM25) search merged via RRF (k=60) yielding initial candidates",
        "Step 2 READ: Inspect CodeDNA of seed candidate (symbol name, parameter types, signature, imported modules)",
        "Step 3 EXPAND: Traverse NetworkX call-graph edges to discover caller/callee neighbors (bounded to ≤5 internal symbols)",
        "Step 4 RERANK: ExplainableReranker scores combined candidates against query intent with seed anchor boost"
      ]
    },

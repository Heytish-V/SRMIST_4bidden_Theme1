  "cards": [
    {
      "dot": "cyan",
      "title": "Offline Indexing & Graph Pipeline (NIVED + MITHUN + HEYTISH)",
      "items": [
        "parser/ast_parser.py: TreeSitterParser.parse() extracts imports, calls, params, and docstrings",
        "parser/chunker.py: SemanticChunker.chunk_file() chunks along syntax boundaries into CodeChunk[]",
        "indexing/code_dna.py: build_code_dna() extracts CodeDNA{symbol, calls, imports, params, signature}",
        "graph/call_graph.py: build_call_graph() creates NetworkX DiGraph with caller-callee hierarchies",
        "retrieval/dense_search.py: DenseRetriever.build_index() embeds with BGE-small-en-v1.5 into FAISS",
        "retrieval/sparse_search.py: SparseRetriever.build_index() tokenizes and indexes with BM25"
      ]
    },
    {
      "dot": "emerald",
      "title": "Online Agentic Search & Reranking (MITHUN + HEYTISH)",
      "items": [
        "retrieval/engine.py: retrieve() executes dual FAISS/BM25 search and reciprocal_rank_fusion(k=60)",
        "agent/controller.py: Bounded 4-step state machine: Step 1 SEARCH → Step 2 READ → Step 3 EXPAND → Step 4 RERANK",
        "agent/tools.py: Wraps retrieval engine, call graph traversal, and source loader into deterministic tool calls",
        "retrieval/reranker.py: ExplainableReranker computes balanced score: semantic (35%) + BM25 (25%) + symbol (25%) + graph (15%)",
        "Sub-50ms CPU execution with complete agent_trace[] reasoning log returned with every search response"
      ]
    },
    {
      "dot": "amber",
      "title": "API Serving, Explainability & Benchmarks (DURGA + HEYTISH)",
      "items": [
        "backend/app.py: FastAPI REST endpoints (/query, /agent-query, /trace, /source, /evaluate, /health)",
        "frontend/src/App.jsx: Interactive React search UI with real-time 4-step trace timeline and source inspector",
        "WhyThisResult.jsx: Interactive modal showing full score attribution and 'why matched' rationale",
        "evaluation/evaluate_pipeline.py: Automated benchmark achieving 100% Pass Rate (10/10), 0.80 MRR@5, and 33.6ms latency on demo_repo"
      ]
    }
  ]
